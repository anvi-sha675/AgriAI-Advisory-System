# AgriAI Backend — Environment Variables
# Copy this to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/agriai
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/agriai
MONGODB_URI=mongodb://localhost:27017/agriai

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── Google Gemini API (free tier available) ────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenWeatherMap API (free tier available) ──────────────────────────────────
# Get key at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# ── CORS (frontend URL) ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google OAuth (optional — sign-in with Google) ──────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
